NODE_ENV=development
HOST=0.0.0.0
PORT=3001
API_KEY=replace-with-random-secret-minimum-32-characters
CORS_ORIGIN=http://localhost:5001
LOG_LEVEL=info

# WhatsApp (global — shared by all tenants)
WA_AUTH_PATH=./data/auth
WA_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SEND_RATE_LIMIT_MAX=20
TRUST_PROXY=1

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rorojongrang
DB_PASSWORD=replace-with-strong-database-password
DB_NAME=rorojongrang_wa

# Tenant admin API
ADMIN_KEY=replace-with-different-random-admin-secret

# Google OAuth — paste Client ID & Secret dari console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Session
SESSION_SECRET=replace-with-random-session-secret-minimum-32-characters
SESSION_MAX_AGE_MS=604800000

# Encryption key for API keys (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-characters

# Groq API Key (platform default)
GROQ_API_KEY=
AI_API_KEY=
