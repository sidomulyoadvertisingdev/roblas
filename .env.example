NODE_ENV=development
HOST=0.0.0.0
PORT=3001
API_KEY=your-api-key-here
CORS_ORIGIN=http://localhost:5001
LOG_LEVEL=info

# WhatsApp (global — shared by all tenants)
WA_AUTH_PATH=./data/auth
WA_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
SEND_RATE_LIMIT_MAX=20
TRUST_PROXY=1

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=rorojongrang_wa

# Tenant admin API
ADMIN_KEY=your-admin-key-min-16-chars

# --- Single-tenant only (ignored in multi-tenant mode) ---
# WA_CLIENT_ID=rorojongrang
# WA_BOT_PHONE=085720484364
# BOT_ENABLED=true
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.1-8b-instant
